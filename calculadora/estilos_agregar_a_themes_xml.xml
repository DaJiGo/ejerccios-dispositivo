<!--
    IMPORTANTE:
    Agrega estos 4 estilos dentro de tu archivo
    res/values/themes.xml (o res/values/styles.xml),
    dentro del bloque <resources> ... </resources> existente,
    junto al estilo del tema principal (no lo borres, solo agrega estos debajo).
-->
<resources>

    <style name="BotonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="BotonNumero" parent="BotonBase">
        <item name="android:backgroundTint">#333333</item>
    </style>

    <style name="BotonFuncion" parent="BotonBase">
        <item name="android:backgroundTint">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="BotonOperador" parent="BotonBase">
        <item name="android:backgroundTint">#FF9500</item>
    </style>

    <style name="BotonIgual" parent="BotonBase">
        <item name="android:backgroundTint">#FF9500</item>
    </style>

</resources>
